// TEST - V3 Date Completion | Purpose/role: T02 seven-day completion extension | Specification revision: 3; interface 1.1 | Contract: Direct launch; ignores input; seven iteration traces and final guard; no writes; final copyable Text report | Dependencies: Passing T02 three-day test; native Date slot | Stage: Source reviewed only; not compiled or executed
import Shortcuts
var report = "TEST - V3 Date Completion | source revision 3 | Observed values below; native types/settings and manual repairs must be recorded separately."
// T02C-DATE ADD/RECONNECT: Replace ONLY next Nothing with native Date, Specified Date=9 November 2026 12:00 Europe/London; reconnect Set Variable cursorDate to native Date output before deleting Nothing. Preserve initializer outside Repeat.
nothing() >> nativeDate
var cursorDate = nativeDate
var endIso = "2026-11-15"
var complete = "off"
repeat(7) {
// T02C-FORMAT CHECK: Format and Adjust inputs=CURRENT NAMED cursorDate, not initializer. Format=Custom yyyy-MM-dd, Time=None; English UK/Gregorian/Europe London where exposed. Store only Adjusted Date back into cursorDate inside Repeat.
formatDate(date: "${cursorDate}", dStyle: Custom, tStyle: None, custom: "yyyy-MM-dd", isoTime: false) >> cursorIso
// T02C-EQUALITY CHECK: If left=THIS iteration cursorIso Text, operator=is, RHS=CURRENT NAMED endIso Text. Record untouched RHS before any repair. True branch sets named complete=literal Text on inside Repeat.
if(cursorIso == endIso) {
complete = "on"
}
text(text: """
${report}
Iteration ${RepeatIndex}: current=[${cursorIso}] end=[${endIso}] complete=[${complete}]
""") >> reportPart1
report = reportPart1
if(complete == "off") {
// T02C-UNIT CHECK/REPAIR: T02a revision 4 was reported generated as Add 1 SECOND despite source 1 day; changing native unit to DAY produced the expected three-day advancement. Inspect this installed action: Add, amount=1, unit=day, input=CURRENT NAMED cursorDate Date. If seconds, record then change ONLY unit to day; keep action INSIDE its existing Repeat/guard. Preserve nextDate Adjusted Date output connections to downstream consumers and Set Variable cursorDate. Do not replace calendar days with seconds arithmetic. This comment-only clarification does not establish generation or runtime for this source.
adjustDate(operation: Add, duration: 1 day, date: "${cursorDate}") >> nextDate
cursorDate = nextDate
}
}
// T02C-FINAL CHECK: Final If left=CURRENT NAMED complete after Repeat, operator=is not, RHS=literal Text on; preserve original off initializer. Final Text also reads current complete.
if(complete != "on") {
alert(alert: "Completion guard failed: complete is not on. Preserve the seven traces.", title: "T02 final guard", cancel: false)
}
text(text: "T02 final complete=[${complete}] expected=[on]") >> finalReport
text(text: """
${report}
${finalReport}
Expected current sequence: 2026-11-09 through 2026-11-15; complete off through iteration 6 and on at iteration 7.
""") >> reportPart2
report = reportPart2

// REPORT-FINAL CHECK: After all branches/loops, cleanup input=CURRENT NAMED report Text, not its initializer. All report updates must Set Variable report=their own preceding reportPart output (unique magic-variable name per source action). Preserve date/number producers; report Text is display only. Quick Look and final Get Text both read cleanedReport. No Output/Exit binding. Runtime action errors may abort before this report.
replaceText(input: "${report}", find: "(?m)^ *\"{2} *$", replace: "", isRegex: true, caseSensitive: true) >> cleanedReport
quicklook(input: cleanedReport)
getTextFrom(input: cleanedReport)
