// Installed name: TEST - G3C Context Caller
// Purpose/role: Inspect PDF/category List return and extraction; independent generation diagnostic.
// Specification revision: 1; interface 1.0. Contract: Select one PDF; expected Count 2, native PDF type/full PDF, then Anthems; no explicit return
// Dependencies: TEST - G3 Exit Context interface 1.0. Exact installed targets must match source; export filenames do not set installed names.
// Side effects: Reads/previews one PDF/category; provider download possible; no writes.
// Target: iPadOS/Jellycuts versions must be recorded; previous profile iPadOS 26.6 / Jellycuts 2026.6.4. Local comparison Open-Jellycore e1ec31c / Swift 6.4.1.
// Stage: Candidate, not iPad compiled/imported/executed. Local build results: generation-groups-builds.md. Test instructions/results: generation-groups.md.
// Setup: No native fixture slots. Import unchanged first; do not repair before recording the untouched result.
import Shortcuts

selectFile(type: Files, multiple: false) >> sentFile
runShortcut(name: "TEST - G3 Exit Context", input: sentFile, show: false) >> returnedContext
count(type: Items, input: returnedContext) >> returnedCount
quicklook(input: returnedCount)
nothing() >> emptyFile
var returnedFile = emptyFile
var returnedCategory = ""
repeatEach(returnedContext) {
if(RepeatIndex == "1") {
returnedFile = RepeatItem
}
if(RepeatIndex == "2") {
returnedCategory = RepeatItem
}
}
getType(input: returnedFile) >> returnedFileType
quicklook(input: returnedFileType)
quicklook(input: returnedFile)
quicklook(input: returnedCategory)
