// TEST - G2B Double Add Files | Purpose/role: Test two var += additions per PDF within a loop; independent generation diagnostic. | Specification revision: 1; interface 1.0. Contract: Select exactly two distinct PDFs; expected selected Count 2 then collection Count 4 and PDF A, A, B, B; no explicit return | Dependencies: None. Exact installed targets must match source; export filenames do not set installed names. | Side effects: Reads/previews selected PDFs and type names; provider downloads possible; no writes. | Target: iPadOS/Jellycuts versions must be recorded; previous profile iPadOS 26.6 / Jellycuts 2026.6.4. Local comparison Open-Jellycore e1ec31c / Swift 6.4.1. | Stage: Candidate, not iPad compiled/imported/executed. Local build results: generation-groups-builds.md. Test instructions/results: generation-groups.md. | Setup: No native fixture slots. Import unchanged first; do not repair before recording the untouched result.
import Shortcuts

selectFile(type: Files, multiple: true) >> selectedFiles
count(type: Items, input: selectedFiles) >> selectedCount
quicklook(input: selectedCount)
nothing() >> emptyCollection
var collectedFiles = emptyCollection
var firstFile = emptyCollection
repeatEach(selectedFiles) {
if(RepeatIndex == "1") {
firstFile = RepeatItem
}
var collectedFiles += RepeatItem
var collectedFiles += RepeatItem
}
count(type: Items, input: collectedFiles) >> collectedCount
quicklook(input: collectedCount)
repeatEach(collectedFiles) {
quicklook(input: RepeatIndex)
getType(input: RepeatItem) >> itemType
quicklook(input: itemType)
quicklook(input: RepeatItem)
}
