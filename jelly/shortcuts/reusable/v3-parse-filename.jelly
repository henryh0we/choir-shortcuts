// V3 - Parse Filename | Purpose/role: Shared read-only filename parser | Specification revision: 3; interface 2.0 | Contract: Two Text List items filename/config JSON; one native Dictionary including error status; no prompts or writes | Dependencies: None | Stage: Source reviewed only; natural completion requires iPad check; docs/v3-output-resolution.md
import Shortcuts

// SETTINGS / FORMATTING: Supplied v3-config.json snapshot owns filenameFormats and weeklySchedule. Dates/overrides remain outside this increment. There are no generated stop/return bindings or manual completion slots: runState gates processing and the final Get Dictionary supplies the result on normal completion.
nothing() >> emptyContext
var config = emptyContext
var formats = emptyContext
var schedule = emptyContext
var rules = emptyContext
var extensionPattern = emptyContext
var filenameStem = emptyContext
var configuredDay = emptyContext
var configuredSlot = emptyContext
var runState = "ready"
var errorMessage = ""
var filename = ""
var configJson = ""
var status = "unresolved"
var reason = "No configured filename rule matched. No service was guessed."
var dayKey = ""
var slotKey = ""
var serviceName = ""
var position = ""
var canonicalName = ""
var resultRuleKey = ""
var selectedRuleKey = ""
var selectedPattern = ""
var selectedDay = ""
var selectedSlot = ""
var selectedSpecial = ""
nothing() >> emptyMatches
var matchedRuleKeys = emptyMatches
count(type: Items, input: ShortcutInput) >> argumentCount
text(text: "${argumentCount}") >> argumentCountText
if(argumentCountText != "2") {
runState = "error"
errorMessage = "Supply two Text items: filename and v3 config JSON."
}
if(runState == "ready") {
repeatEach(ShortcutInput) {
if(RepeatIndex == "1") {
filename = RepeatItem
}
if(RepeatIndex == "2") {
configJson = RepeatItem
}
}
if(filename == nil) {
runState = "error"
errorMessage = "V3 filename is empty."
}
if(configJson == nil) {
runState = "error"
errorMessage = "V3 config JSON is empty."
}
}
if(runState == "ready") {
getDictionaryFrom(input: configJson) >> configResult
config = configResult
valueFor(key: "version", dictionary: config) >> version
text(text: "${version}") >> versionText
if(versionText != "3") {
runState = "error"
errorMessage = "V3 requires its separate config version 3."
}
}
if(runState == "ready") {
valueFor(key: "filenameFormats", dictionary: config) >> formatsResult
formats = formatsResult
valueFor(key: "weeklySchedule", dictionary: config) >> scheduleResult
schedule = scheduleResult
if(formats == nil) {
runState = "error"
errorMessage = "V3 filenameFormats is missing or empty."
}
if(schedule == nil) {
runState = "error"
errorMessage = "V3 weeklySchedule is missing or empty."
}
}
if(runState == "ready") {
valueFor(key: "rules", dictionary: formats) >> rulesResult
rules = rulesResult
valueFor(key: "terminalExtensionPattern", dictionary: formats) >> extensionPatternResult
extensionPattern = extensionPatternResult
valueFor(key: "caseSensitive", dictionary: formats) >> caseSetting
if(rules == nil) {
runState = "error"
errorMessage = "V3 filenameFormats.rules is missing or empty."
}
if(extensionPattern != "[.]pdf$") {
runState = "error"
errorMessage = "This increment supports terminalExtensionPattern [.]pdf$ only."
}
if(caseSetting != "off") {
runState = "error"
errorMessage = "This increment requires filenameFormats.caseSensitive off."
}
}
if(runState == "ready") {
replaceText(input: "${filename}", find: "${extensionPattern}", replace: "", isRegex: true, caseSensitive: false) >> filenameStemResult
filenameStem = filenameStemResult
// V3-PARSE-RULES CHECK: Each Repeat reads rules; all dependent rule actions are gated by current named runState. Add ruleKey Text to current named matchedRuleKeys; keep emptyMatches initializer. No stop action is needed to skip later rules after an error.
repeatEach(rules) {
if(runState == "ready") {
valueFor(key: "key", dictionary: RepeatItem) >> ruleKey
valueFor(key: "pattern", dictionary: RepeatItem) >> rulePattern
valueFor(key: "dayKey", dictionary: RepeatItem) >> ruleDay
valueFor(key: "slotKey", dictionary: RepeatItem) >> ruleSlot
valueFor(key: "special", dictionary: RepeatItem) >> ruleSpecial
if(ruleKey == nil) {
runState = "error"
errorMessage = "A V3 filename rule has no key."
}
if(rulePattern == nil) {
runState = "error"
errorMessage = "V3 rule ${ruleKey} has no pattern."
}
if(ruleDay == nil) {
runState = "error"
errorMessage = "V3 rule ${ruleKey} has no dayKey."
}
if(ruleSlot == nil) {
runState = "error"
errorMessage = "V3 rule ${ruleKey} has no slotKey."
}
matchText(text: "${ruleSpecial}", regex: "^(on|off)$", caseSensitive: true) >> validSpecialSetting
if(validSpecialSetting == nil) {
runState = "error"
errorMessage = "V3 rule ${ruleKey} needs special on or off."
}
if(runState == "ready") {
matchText(text: "${filenameStem}", regex: "${rulePattern}", caseSensitive: false) >> ruleMatch
if(ruleMatch != nil) {
var matchedRuleKeys += ruleKey
selectedRuleKey = ruleKey
selectedPattern = rulePattern
selectedDay = ruleDay
selectedSlot = ruleSlot
selectedSpecial = ruleSpecial
}
}
}
}
}
if(runState == "ready") {
count(type: Items, input: matchedRuleKeys) >> matchCount
text(text: "${matchCount}") >> matchCountText
if(matchCountText != "0") {
reason = "Multiple configured rules matched. Resolve the conflict in v3-config.json."
}
if(matchCountText == "1") {
replaceText(input: "${filenameStem}", find: "${selectedPattern}", replace: "$1", isRegex: true, caseSensitive: false) >> prefixOrSuffix
replaceText(input: "${filenameStem}", find: "${selectedPattern}", replace: "$2", isRegex: true, caseSensitive: false) >> parsedPosition
replaceText(input: "${filenameStem}", find: "${selectedPattern}", replace: "$3", isRegex: true, caseSensitive: false) >> parsedPayload
matchText(text: "${parsedPosition}", regex: "^[1-9][0-9]*$", caseSensitive: true) >> validPosition
matchText(text: "${parsedPayload}", regex: "[^[:space:]]", caseSensitive: true) >> usablePayload
if(validPosition == nil) {
runState = "error"
errorMessage = "V3 rule ${selectedRuleKey} did not yield a positive position in capture group 2."
}
if(usablePayload == nil) {
runState = "error"
errorMessage = "V3 rule ${selectedRuleKey} yielded an empty payload in capture group 3."
}
if(runState == "ready") {
dayKey = selectedDay
slotKey = selectedSlot
position = parsedPosition
canonicalName = parsedPayload
resultRuleKey = selectedRuleKey
valueFor(key: "${dayKey}", dictionary: schedule) >> configuredDayResult
configuredDay = configuredDayResult
if(configuredDay == nil) {
runState = "error"
errorMessage = "V3 rule ${selectedRuleKey} names a day missing from weeklySchedule."
}
}
if(runState == "ready") {
valueFor(key: "enabled", dictionary: configuredDay) >> dayEnabled
matchText(text: "${dayEnabled}", regex: "^(on|off)$", caseSensitive: true) >> validDaySwitch
if(validDaySwitch == nil) {
runState = "error"
errorMessage = "V3 day ${dayKey} needs enabled on or off."
}
if(selectedSpecial == "off") {
valueFor(key: "slots", dictionary: configuredDay) >> configuredSlots
if(configuredSlots == nil) {
runState = "error"
errorMessage = "V3 day ${dayKey} needs regular slots."
}
if(runState == "ready") {
valueFor(key: "${slotKey}", dictionary: configuredSlots) >> configuredSlotResult
configuredSlot = configuredSlotResult
if(configuredSlot == nil) {
runState = "error"
errorMessage = "V3 rule ${selectedRuleKey} names an unconfigured regular slot."
}
}
if(runState == "ready") {
valueFor(key: "name", dictionary: configuredSlot) >> configuredName
valueFor(key: "enabled", dictionary: configuredSlot) >> slotEnabled
if(configuredName == nil) {
runState = "error"
errorMessage = "V3 slot ${slotKey} needs a name."
}
matchText(text: "${slotEnabled}", regex: "^(on|off)$", caseSensitive: true) >> validSlotSwitch
if(validSlotSwitch == nil) {
runState = "error"
errorMessage = "V3 slot ${slotKey} needs enabled on or off."
}
if(runState == "ready") {
serviceName = configuredName
status = "parsed"
reason = "Recognised regular service; filename position is not yet sorted or date-resolved."
if(slotEnabled == "off") {
status = "skipped"
reason = "Service slot disabled by configuration."
}
}
}
}
if(runState == "ready") {
if(selectedSpecial == "on") {
changeCase(text: "${prefixOrSuffix}", case: lowercase) >> lowerSuffix
text(text: "${selectedSlot}${lowerSuffix}") >> specialSlotText
slotKey = specialSlotText
serviceName = prefixOrSuffix
status = "parsed"
reason = "Recognised special suffix; date overrides are not yet applied."
}
if(dayEnabled == "off") {
status = "skipped"
reason = "Day disabled by configuration."
}
}
}
}
}
if(runState == "error") {
status = "error"
reason = errorMessage
dayKey = ""
slotKey = ""
serviceName = ""
position = ""
canonicalName = ""
resultRuleKey = ""
}
var resultTemplate = """
{"schemaVersion":"2","status":"unresolved","sourceName":"","ruleKey":"","dayKey":"","serviceSlot":"","serviceName":"","position":"","canonicalName":"","reason":""}
"""
getDictionaryFrom(input: resultTemplate) >> resultBase
setValue(key: "status", value: "${status}", dictionary: resultBase) >> resultStatus
setValue(key: "sourceName", value: "${filename}", dictionary: resultStatus) >> resultSource
setValue(key: "ruleKey", value: "${resultRuleKey}", dictionary: resultSource) >> resultRule
setValue(key: "dayKey", value: "${dayKey}", dictionary: resultRule) >> resultDay
setValue(key: "serviceSlot", value: "${slotKey}", dictionary: resultDay) >> resultSlot
setValue(key: "serviceName", value: "${serviceName}", dictionary: resultSlot) >> resultService
setValue(key: "position", value: "${position}", dictionary: resultService) >> resultPosition
setValue(key: "canonicalName", value: "${canonicalName}", dictionary: resultPosition) >> resultCanonical
setValue(key: "reason", value: "${reason}", dictionary: resultCanonical) >> finalResult
// V3-PARSE-COMPLETION CHECK: Last executable action must be Get Dictionary from finalResult native Dictionary, outside all branches/loops. Natural completion supplies its result to the caller; no Stop/Output/Exit binding, manual slot, display or following action. Confirm the actual caller receives schemaVersion 2 plus status/reason on iPad.
getDictionaryFrom(input: finalResult)
