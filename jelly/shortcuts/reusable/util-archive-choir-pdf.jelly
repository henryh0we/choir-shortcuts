// Installed name: UTIL - Archive Choir PDF
// Purpose: Generated archive helper; complete CFG slots after importing.
// Role: Reusable; specification revision 15; completed interface 2.1.
// Input: Native List: one PDF File, native Library Folder, parsed config Dictionary.
// Output after assembly: Native File on success; Text starting ERROR: on validation failure. Caller must reject error Text before import.
// Direct/called: May ask for a type folder when absent; no unattended mode.
// Side effects after assembly: Save a canonical clean PDF; never overwrite.
// Dependency: UTIL - Canonical Choir Name interface 2.0, util-canonical-choir-name.jelly.
// Target: iPadOS 26.6, Jellycuts 2026.6.4; selected iCloud archive folder permission.
// Stage: Drafted; quoted-index extraction follows confirmed Text tests, but this mixed File/Folder/Dictionary loop needs device testing. Local build evidence: ../../tests/config-integration.md.
// Assembly and tests: ../../docs/config-integration.md; ../../tests/config-integration.md

import Shortcuts

// VALIDATION: Device-confirmed probe uses parenthesized If, flush-left actions and positional output("ERROR: ..."). Missing noResultBehaviour/response warnings remain in the probe; no successful named-parameter repair is known. Full helper revision still needs device verification.

// ASSEMBLY GUARD: Keep the next unconditional Output until the existing native action slots are complete. Validation If blocks below contain executable text-error Output calls.
// INITIAL GUARD: Remove only this first Output once the existing native action slots are complete.
output("ERROR: Archive helper needs CFG02-CFG04 completed and native context extraction checked.")

count(type: Items, input: ShortcutInput) >> contextCount
text(text: "${contextCount}") >> contextCountText
if(contextCountText != "3") {
output("ERROR: Supply a native List: one PDF File, Library Folder, parsed config Dictionary.")
}
// SOURCE CONTEXT EXTRACTION: Replaces ARC01-ARC03 with quoted RepeatIndex comparisons. Initialize with Nothing, not Text; assign whole native Repeat Items. UNVERIFIED: Mixed native List transport and downstream named-variable wiring need device inspection; see ../../tests/compatibility/archive-context-loop.md before enabling writes.
nothing() >> emptyContextItem
var sourceFile = emptyContextItem
var archiveRoot = emptyContextItem
var workflowConfig = emptyContextItem
repeatEach(ShortcutInput) {
if(RepeatIndex == "1") {
sourceFile = RepeatItem
}
if(RepeatIndex == "2") {
archiveRoot = RepeatItem
}
if(RepeatIndex == "3") {
workflowConfig = RepeatItem
}
}
if(sourceFile == nil) {
output("ERROR: Supply one PDF File.")
}
if(archiveRoot == nil) {
output("ERROR: Supply the native Library Folder as input item 2.")
}
if(workflowConfig == nil) {
output("ERROR: Supply the parsed config Dictionary as input item 3.")
}
valueFor(key: "version", dictionary: workflowConfig) >> configVersion
text(text: "${configVersion}") >> configVersionText
if(configVersionText != "1") {
output("ERROR: Only config version 1 is supported.")
}
valueFor(key: "prefixRegex", dictionary: workflowConfig) >> prefixRegex
valueFor(key: "categories", dictionary: workflowConfig) >> categories
valueFor(key: "libraryFolder", dictionary: workflowConfig) >> libraryFolderName
if(libraryFolderName == nil) {
output("ERROR: Set libraryFolder in config.json.")
}
fileDetail(input: archiveRoot, property: Name) >> actualLibraryName
if(actualLibraryName != "${libraryFolderName}") {
output("ERROR: Input item 2 must be the native ${libraryFolderName} Folder beneath Choir Music.")
}
if(prefixRegex == nil) {
output("ERROR: Set prefixRegex in config.json.")
}
if(categories == nil) {
output("ERROR: Set a nonempty categories array in config.json.")
}
count(type: Items, input: sourceFile) >> inputCount
text(text: "${inputCount}") >> inputCountText
if(inputCountText != "1") {
output("ERROR: Supply exactly one PDF File.")
}
fileDetail(input: sourceFile, property: File Extension) >> sourceExtension
changeCase(text: "${sourceExtension}", case: lowercase) >> lowerExtension
if(lowerExtension != "pdf") {
output("ERROR: No file saved. Select a PDF.")
}
fileDetail(input: sourceFile, property: Name) >> sourceName
list(items: [sourceName, prefixRegex]) >> sourceNameInput
runShortcut(name: "UTIL - Canonical Choir Name", input: sourceNameInput, show: false) >> canonicalStem
if(canonicalStem == nil) {
output("ERROR: A file named only .pdf is not supported.")
}

// Old CFG01 is retired: archiveRoot is the native Library Folder from context item 2.

getFolderContents(folder: archiveRoot, recursive: true) >> archiveContents
// A named variable survives the loop without capturing Repeat Results. Keep the native File when exactly one canonical match exists. UNVERIFIED: Check both If inputs and CFG03 use the named variable after export.
nothing() >> noArchiveMatch
// LOOP SCOPE: Declare comparison variables before Repeat; assign captured outputs before each If. Inspect the named-variable tokens after export.
var archiveExtensionLower = ""
var archiveStem = ""
var existingCleanFile = noArchiveMatch
repeatEach(archiveContents) {
fileDetail(input: RepeatItem, property: File Extension) >> archiveExtension
changeCase(text: "${archiveExtension}", case: lowercase) >> archiveExtensionLowerResult
archiveExtensionLower = archiveExtensionLowerResult
if(archiveExtensionLower == "pdf") {
fileDetail(input: RepeatItem, property: Name) >> archiveName
list(items: [archiveName, prefixRegex]) >> archiveNameInput
runShortcut(name: "UTIL - Canonical Choir Name", input: archiveNameInput, show: false) >> archiveStemResult
archiveStem = archiveStemResult
if(archiveStem == "${canonicalStem}") {
if(existingCleanFile != nil) {
output("ERROR: Resolve duplicate canonical PDFs in iCloud before retrying.")
}
existingCleanFile = RepeatItem
}
}
}

if(existingCleanFile != nil) {
// CFG03: Set the next Stop and Output result to named native existingCleanFile after export; preserve File type.
output("")
}

choose(list: categories, prompt: "Choose the music category from config.json.", multiple: false, all: false) >> chosenCategory
if(chosenCategory == nil) {
output("ERROR: No category selected. No PDF saved.")
}
// Resolve category Text to an immediate native Library Folder; never use Text as a save destination.
getFolderContents(folder: archiveRoot, recursive: false) >> libraryChildren
nothing() >> noCategoryFolder
var childName = ""
var typeFolder = noCategoryFolder
repeatEach(libraryChildren) {
fileDetail(input: RepeatItem, property: Name) >> childNameResult
childName = childNameResult
if(childName == "${chosenCategory}") {
if(typeFolder != nil) {
output("ERROR: Multiple Library children match the selected category.")
}
typeFolder = RepeatItem
}
}
if(typeFolder == nil) {
output("ERROR: Library has no folder named ${chosenCategory}. Fix config.json or the folders.")
}
// Folder preflight must succeed before Set Name or Save File.
getFolderContents(folder: typeFolder, recursive: false) >> categoryContents
setName(input: sourceFile, name: "${canonicalStem}.pdf", dontIncludeExtension: false) >> renamedFile
// CFG02 SAVE DESTINATION. The next Save File is generated with its picker enabled because the reviewed binding cannot encode a Folder destination. Set Ask Where to Save OFF and Destination to the named native typeFolder variable. Keep Overwrite OFF and the native renamedFile input.
saveFile(input: renamedFile, ask: true, path: "", overwrite: false) >> savedCleanFile
// CFG04: In the next Stop and Output, select native savedCleanFile from Save File after export; preserve File type.
output("")
