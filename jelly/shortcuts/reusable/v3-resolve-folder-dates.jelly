// V3 - Resolve Folder Dates | Purpose/role: Shared V3 folder-date resolver | Specification revision: 4; interface 1.0 | Contract: Three Text List items folder name/config JSON/saved context JSON; one Dictionary on natural completion; no writes or prompts | Dependencies: None | Stage: Source review only; nonempty optional-field probes await iPad check
import Shortcuts

// V3-DATES-CURRENT ADD/RECONNECT: At this top-level position replace ONLY next Nothing with native Date set to Current Date. Reconnect immediately following Set Variable currentDate input to that native Date output before deleting placeholder. Preserve this Set Variable; later missing-value If and yyyy Format Date must read CURRENT NAMED currentDate, not the Nothing or an initial Text. Keep both actions here before all branches/loops; no year prompt.
nothing() >> currentDateResult
var currentDate = currentDateResult

var folderName = ""
var configJson = ""
var contextJson = ""
var runState = "ready"
var reason = "Folder dates resolved; no service execution is authorised."
var yearSource = ""
var startIso = ""
var endIso = ""
var qualifier = ""
var contextKey = ""
var complete = "off"
var offset = 0
text(text: "{}") >> emptyJson
getDictionaryFrom(input: emptyJson) >> emptyDictionary
var result = emptyDictionary
count(type: Items, input: ShortcutInput) >> inputCount
text(text: "${inputCount}") >> inputCountText
if(inputCountText != "3") {
runState = "error"
reason = "Supply three Text items: folder name, V3 config JSON and saved folder-context JSON."
}
if(runState == "ready") {
repeatEach(ShortcutInput) {
if(RepeatIndex == "1") {
folderName = RepeatItem
}
if(RepeatIndex == "2") {
configJson = RepeatItem
}
if(RepeatIndex == "3") {
contextJson = RepeatItem
}
}
getDictionaryFrom(input: configJson) >> config
getDictionaryFrom(input: contextJson) >> contexts
valueFor(key: "version", dictionary: config) >> configVersion
text(text: "${configVersion}") >> configVersionText
if(configVersionText != "3") {
runState = "error"
reason = "Folder resolver requires config version 3."
}
valueFor(key: "weekFolderDates", dictionary: config) >> dateSettings
valueFor(key: "pattern", dictionary: dateSettings) >> folderPattern
valueFor(key: "months", dictionary: dateSettings) >> months
valueFor(key: "weekdayKeys", dictionary: dateSettings) >> weekdayKeys
valueFor(key: "sourceNamespace", dictionary: dateSettings) >> sourceNamespace
valueFor(key: "yearSource", dictionary: dateSettings) >> yearPolicy
valueFor(key: "timezone", dictionary: dateSettings) >> timezone
if(yearPolicy != "saved-context-then-explicit-then-current") {
runState = "error"
reason = "This resolver requires saved-context-then-explicit-then-current year policy."
}
if(timezone != "Europe/London") {
runState = "error"
reason = "This checkpoint supports Europe/London only; inspect native date settings."
}
if(folderPattern == nil) {
runState = "error"
reason = "Use the Stage 2B config: weekFolderDates.pattern is missing."
}
if(months == nil) {
runState = "error"
reason = "weekFolderDates.months is missing."
}
if(weekdayKeys == nil) {
runState = "error"
reason = "weekFolderDates.weekdayKeys is missing."
}
if(sourceNamespace == nil) {
runState = "error"
reason = "weekFolderDates.sourceNamespace is missing."
}
}
if(runState == "ready") {
matchText(text: "${folderName}", regex: "${folderPattern}", caseSensitive: false) >> folderMatch
if(folderMatch == nil) {
runState = "unresolved"
reason = "Unsupported date-folder name; no contents were assigned to services."
}
}
if(runState == "ready") {
replaceText(input: "${folderName}", find: "${folderPattern}", replace: "$1", isRegex: true, caseSensitive: false) >> startMonthName
replaceText(input: "${folderName}", find: "${folderPattern}", replace: "$2", isRegex: true, caseSensitive: false) >> startDay
replaceText(input: "${folderName}", find: "${folderPattern}", replace: "$3", isRegex: true, caseSensitive: false) >> endMonthName
replaceText(input: "${folderName}", find: "${folderPattern}", replace: "$4", isRegex: true, caseSensitive: false) >> endDayCapture
replaceText(input: "${folderName}", find: "${folderPattern}", replace: "$5", isRegex: true, caseSensitive: false) >> explicitYear
replaceText(input: "${folderName}", find: "${folderPattern}", replace: "$6", isRegex: true, caseSensitive: false) >> qualifierCapture
qualifier = qualifierCapture
text(text: "${sourceNamespace}/${folderName}") >> contextKeyText
contextKey = contextKeyText
// V3-DATES-CONTEXT-KEY CHECK: Get Dictionary Value Key=current named contextKey Text or immediately preceding contextKeyText output, never its empty initializer; Dictionary=contexts. HNov8 normal key=ScannedChoirMusic/HNov8. Missing entry is valid; empty lookup Key is not. For manual diagnosis only, add Show Alert immediately before this lookup with literal DATE KEY plus actual Key token and after it with literal DATE CONTEXT LOOKUP RETURNED; preserve savedRange consumers and remove only these temporary alerts afterwards.
valueFor(key: "${contextKey}", dictionary: contexts) >> savedRange
if(savedRange != nil) {
matchText(text: "${savedRange}", regex: "^[0-9]{4}-[0-9]{2}-[0-9]{2}/[0-9]{4}-[0-9]{2}-[0-9]{2}$", caseSensitive: true) >> validSavedRange
if(validSavedRange == nil) {
runState = "error"
reason = "Saved folder dates are invalid; do not silently replace saved context with another year."
}
if(runState == "ready") {
replaceText(input: "${savedRange}", find: "^([^/]+)/([^/]+)$", replace: "$1", isRegex: true, caseSensitive: true) >> savedStart
replaceText(input: "${savedRange}", find: "^([^/]+)/([^/]+)$", replace: "$2", isRegex: true, caseSensitive: true) >> savedEnd
startIso = savedStart
endIso = savedEnd
yearSource = "saved-context"
}
}
if(savedRange == nil) {
var resolvedYear = explicitYear
yearSource = "explicit-folder-year"
// V3-DATES-YEAR CHECK: Text=literal year: followed by actual explicitYear token; Match input=THIS yearProbeText output, regex=^year:[0-9]{4}$. Count Items input=yearMatches; If uses yearMatchCountText is Text 0. Prefix keeps native Match input nonempty when capture is absent; preserve current-year fallback.
text(text: "year:${explicitYear}") >> yearProbeText
matchText(text: "${yearProbeText}", regex: "^year:[0-9]{4}$", caseSensitive: true) >> yearMatches
count(type: Items, input: yearMatches) >> yearMatchCount
text(text: "${yearMatchCount}") >> yearMatchCountText
if(yearMatchCountText == "0") {
// V3-DATES-YEAR-INPUT CHECK: Both following missing-value If and yyyy Format Date read current named currentDate set at the top. No Date/Nothing insertion belongs in this branch. Format=Custom yyyy; Gregorian calendar/Europe London where exposed.
if(currentDate == nil) {
runState = "error"
reason = "Setup required: complete V3-DATES-CURRENT with native Current Date."
}
if(runState == "ready") {
formatDate(date: "${currentDate}", dStyle: Custom, tStyle: None, custom: "yyyy", isoTime: false) >> currentYear
resolvedYear = currentYear
yearSource = "current-year"
}
}
if(runState == "ready") {
changeCase(text: "${startMonthName}", case: lowercase) >> lowerStartMonth
// V3-DATES-TRACE-START ADD TEMPORARILY: Show Alert immediately before next Get Value, message START MONTH KEY plus its actual lowerStartMonth Key token, Cancel OFF. Keep in this ready branch; Dictionary=months. Preserve startMonth consumers; remove only temporary alert after diagnosis.
valueFor(key: "${lowerStartMonth}", dictionary: months) >> startMonth
var endMonth = startMonth
var endDay = startDay
var endYear = resolvedYear
// V3-DATES-END-DAY CHECK: Text=literal day: followed by actual endDayCapture token; Match input=THIS endDayProbeText output, regex=^day:([12][0-9]|3[01]|[1-9])$. Count=endDayMatches; If=endDayMatchCountText is Text 1. Preserve endDay=startDay default; prefix prevents empty native Match input.
text(text: "day:${endDayCapture}") >> endDayProbeText
matchText(text: "${endDayProbeText}", regex: "^day:([12][0-9]|3[01]|[1-9])$", caseSensitive: true) >> endDayMatches
count(type: Items, input: endDayMatches) >> endDayMatchCount
text(text: "${endDayMatchCount}") >> endDayMatchCountText
if(endDayMatchCountText == "1") {
endDay = endDayCapture
}
// V3-DATES-END-MONTH CHECK: Text=literal month: followed by actual endMonthName token; Match input=THIS endMonthProbeText output, regex=^month:[A-Za-z]{3}$. Count=endMonthMatches; If=endMonthMatchCountText is Text 1. Keep endMonth=startMonth; INov9-15 yields month:, count 0 and skips lookup. Prefix prevents empty native Match input.
text(text: "month:${endMonthName}") >> endMonthProbeText
matchText(text: "${endMonthProbeText}", regex: "^month:[A-Za-z]{3}$", caseSensitive: true) >> endMonthMatches
count(type: Items, input: endMonthMatches) >> endMonthMatchCount
text(text: "${endMonthMatchCount}") >> endMonthMatchCountText
if(endMonthMatchCountText == "1") {
changeCase(text: "${endMonthName}", case: lowercase) >> lowerEndMonth
// V3-DATES-TRACE-END ADD TEMPORARILY: Show Alert immediately before next Get Value inside endMonthMatchCountText-is-1 branch, message END MONTH KEY plus actual lowerEndMonth Key token, Cancel OFF. Preserve Dictionary=months/explicitEndMonth consumers. INov9-15 should skip this branch. Remove only temporary alert after diagnosis.
valueFor(key: "${lowerEndMonth}", dictionary: months) >> explicitEndMonth
endMonth = explicitEndMonth
}
if(startMonth == nil) {
runState = "error"
reason = "Start month has no configured numeric mapping."
}
if(endMonth == nil) {
runState = "error"
reason = "End month has no configured numeric mapping."
}
if(runState == "ready") {
calculate(input: "${startMonth}") >> startMonthNumber
calculate(input: "${endMonth}") >> endMonthNumber
// V3-DATES-ROLLOVER RECONNECT: Installed If was reported with blank right operand. Left=Number output of Calculate endMonth (endMonthNumber); operator=is less than; right=Number output of preceding Calculate startMonth (startMonthNumber). For INov9-15 both=11, so branch must not run. Keep both Calculate actions and If here; inside branch Calculate resolvedYear+1 updates endYear. No action insertion/deletion. Source variable-to-variable comparison is unverified generation; inspect RHS after every reimport.
if(endMonthNumber < startMonthNumber) {
calculate(input: "${resolvedYear} + 1") >> nextYear
endYear = nextYear
}
replaceText(input: "${startDay}", find: "^([0-9])$", replace: "0$1", isRegex: true, caseSensitive: true) >> paddedStartDay
replaceText(input: "${endDay}", find: "^([0-9])$", replace: "0$1", isRegex: true, caseSensitive: true) >> paddedEndDay
text(text: "${resolvedYear}-${startMonth}-${paddedStartDay}") >> constructedStart
text(text: "${endYear}-${endMonth}-${paddedEndDay}") >> constructedEnd
startIso = constructedStart
endIso = constructedEnd
}
}
}
}
if(runState == "ready") {
// V3-DATES-PARSE CHECK: Both Get Dates actions consume their exact ISO yyyy-MM-dd plus local 12:00 Text. Count must be 1 for EACH. All Format Date actions use Custom, Gregorian calendar, English (United Kingdom) locale and Europe/London time zone where exposed; inspect actual tokens. Roundtrip must equal the requested ISO date; native invalid-date errors may abort rather than return a controlled result.
text(text: "${startIso} 12:00") >> startDateText
text(text: "${endIso} 12:00") >> endDateText
getDateFrom(input: startDateText) >> nativeStart
getDateFrom(input: endDateText) >> nativeEnd
count(type: Items, input: nativeStart) >> startCount
count(type: Items, input: nativeEnd) >> endCount
text(text: "${startCount}/${endCount}") >> dateCounts
if(dateCounts != "1/1") {
runState = "unresolved"
reason = "Folder dates did not each resolve to one native Date."
}
if(runState == "ready") {
formatDate(date: "${nativeStart}", dStyle: Custom, tStyle: None, custom: "yyyy-MM-dd", isoTime: false) >> checkedStart
formatDate(date: "${nativeEnd}", dStyle: Custom, tStyle: None, custom: "yyyy-MM-dd", isoTime: false) >> checkedEnd
// V3-DATES-START-ROUNDTRIP RECONNECT: User reports installed If RHS blank. Left=checkedStart from start Format Date, operator=is not, right=CURRENT NAMED startIso Text. Keep comparison here after both Format Date actions. For INov9-15 in 2026 expected start=2026-11-09. No action insertion/deletion.
if(checkedStart != startIso) {
runState = "unresolved"
reason = "Start date failed exact calendar roundtrip."
}
// V3-DATES-END-ROUNDTRIP CHECK: Native If left=checkedEnd from Format Date of nativeEnd, operator=is not, right=CURRENT NAMED endIso. For INov9-15 in 2026 both=2026-11-15. Temporarily insert Text/Quick Look immediately before If showing named endIso, endDateText and checkedEnd actual tokens; preserve both If operands and remove only diagnostic actions afterwards. End Get Dates input=endDateText; end Format Date input=nativeEnd, Custom yyyy-MM-dd.
if(checkedEnd != endIso) {
runState = "unresolved"
reason = "End date failed exact calendar roundtrip."
}
}
}
if(runState == "ready") {
var cursorDate = nativeStart
// V3-DATES-CURSOR RECONNECT: Preserve this cursorDate initializer OUTSIDE Repeat. Inside Repeat, BOTH Format Date inputs and Adjust Date input must use CURRENT NAMED cursorDate, not nativeStart/initializer token. Adjust=Add 1 day; following Set Variable cursorDate input=that Adjusted Date output, inside complete-is-off branch. If Set Variable is absent, add it there; keep initializer. User saw 2026-11-09 repeated seven times; repaired advancement is not yet verified.
// V3-DATES-RANGE CHECK: Repeat exactly 7; current named cursorDate feeds every Format/Adjust action. Custom EEE must produce configured English weekday keys. Adjust Date is Add 1 day (calendar day, not seconds). All Get/Set Dictionary consumers read current named result; a single date stops after its first iteration. No repeated weekday may overwrite a previous date.
repeat(7) {
if(runState == "ready") {
if(complete == "off") {
// V3-DATES-FORMAT-INPUT CHECK: Loop Format Date inputs=current named cursorDate holding nativeStart/Adjusted Date, Custom yyyy-MM-dd and EEE. User reports Text-to-Date conversion error after setting Custom; exact failing input is unverified. For manual diagnosis add temporary Quick Look immediately before failing formatter using the EXACT SAME input token; preserve formatter input/output connections and remove only diagnostic afterwards. Do not type cursorDate/nativeStart as literal Text or store formatted Text back into cursorDate.
formatDate(date: "${cursorDate}", dStyle: Custom, tStyle: None, custom: "yyyy-MM-dd", isoTime: false) >> cursorIso
formatDate(date: "${cursorDate}", dStyle: Custom, tStyle: None, custom: "EEE", isoTime: false) >> cursorShort
changeCase(text: "${cursorShort}", case: lowercase) >> lowerWeekday
// V3-DATES-TRACE-DAY ADD TEMPORARILY: Show Alert immediately before next Get Value inside active range Repeat, message WEEKDAY KEY plus actual lowerWeekday Key token, Cancel OFF. Preserve Dictionary=weekdayKeys/dayKey consumers. Remove only temporary alert after diagnosis; keep original loop and result actions.
valueFor(key: "${lowerWeekday}", dictionary: weekdayKeys) >> dayKey
if(dayKey == nil) {
runState = "error"
reason = "Unmapped formatted weekday; inspect Format Date locale/calendar before assigning dates."
}
if(runState == "ready") {
setValue(key: "date-${dayKey}", value: "${cursorIso}", dictionary: result) >> resultDate
result = resultDate
setValue(key: "ordinal-${dayKey}", value: "${offset}", dictionary: result) >> resultOrdinal
result = resultOrdinal
setValue(key: "short-${dayKey}", value: "${cursorShort}", dictionary: result) >> resultShort
result = resultShort
// V3-DATES-COMPLETE CHECK/RECONNECT: Inside active range Repeat after day fields, If left=THIS iteration cursorIso Format Date Text, operator=is, right=CURRENT NAMED endIso Text. Inspect RHS because user found other generated variable-comparison operands blank. Its true branch MUST Set Variable complete to literal Text on. For INov9-15, 2026-11-15 equals endIso on iteration 7. Preserve following complete-is-off Adjust Date guard; no action insertion/deletion.
if(cursorIso == endIso) {
complete = "on"
}
// V3-DATES-LOOP-TRACE ADD TEMPORARILY: At THIS position inside active Repeat after completion If ends and before complete-is-off branch, Show Alert literal labels Start/Current/End/Complete with actual startIso/cursorIso/endIso/CURRENT NAMED complete tokens; Cancel OFF. Record number of alerts and first/last values. Preserve all If/Format/Adjust/Set connections; remove only this temporary alert afterwards. Expected INov9-15 last current=2026-11-15/end=2026-11-15/complete=on.
if(complete == "off") {
// V3-DATES-UNIT CHECK/REPAIR: T02a revision 4 was reported generated as Add 1 SECOND despite source 1 day; changing native unit to DAY produced the expected three-day advancement. Inspect this installed action: Add, amount=1, unit=day, input=CURRENT NAMED cursorDate Date. If seconds, record then change ONLY unit to day; keep action INSIDE its existing Repeat/guard. Preserve nextDate Adjusted Date output connections to downstream consumers and Set Variable cursorDate. Do not replace calendar days with seconds arithmetic. This comment-only clarification does not establish generation or runtime for this source.
adjustDate(operation: Add, duration: 1 day, date: "${cursorDate}") >> nextDate
cursorDate = nextDate
calculate(input: "${offset} + 1") >> nextOffset
offset = nextOffset
}
}
}
}
}
if(complete != "on") {
if(runState == "ready") {
runState = "unresolved"
reason = "Range is reversed or exceeds 7 inclusive days; no dates will be used or saved. Specify the end month explicitly at month boundaries."
}
}
}
var status = runState
if(runState == "ready") {
status = "resolved"
}
setValue(key: "schemaVersion", value: "1", dictionary: result) >> resultVersion
setValue(key: "status", value: "${status}", dictionary: resultVersion) >> resultStatus
setValue(key: "reason", value: "${reason}", dictionary: resultStatus) >> resultReason
setValue(key: "folderName", value: "${folderName}", dictionary: resultReason) >> resultFolder
setValue(key: "qualifier", value: "${qualifier}", dictionary: resultFolder) >> resultQualifier
setValue(key: "contextKey", value: "${contextKey}", dictionary: resultQualifier) >> resultKey
setValue(key: "yearSource", value: "${yearSource}", dictionary: resultKey) >> resultYear
setValue(key: "startDate", value: "${startIso}", dictionary: resultYear) >> resultStart
setValue(key: "endDate", value: "${endIso}", dictionary: resultStart) >> finalResult
// V3-DATES-RETURN CHECK: Last executable action=Get Dictionary from finalResult outside all branches. Caller must receive schemaVersion 1 and status resolved/error/unresolved; only resolved permits date use and context save. No Output/Exit/manual stop.
getDictionaryFrom(input: finalResult)
