// V3 - Preview Services | Purpose/role: Dated service preview | Specification revision: 2; interface 1.0 | Contract: Direct launch; fixed config; select one folder; report Text; context writes only | Dependencies: V3 - Load Folder Context 1.0; V3 - Prepare Preview Rows 1.0; V3 - Render Service Preview 1.0 | Stage: Source review only; split crash workaround unverified
import Shortcuts
var runState = "ready"
var report = "V3 SERVICE PREVIEW"
var fileIndex = 0
text(text: "{}") >> emptyJson
getDictionaryFrom(input: emptyJson) >> emptyFiles
var files = emptyFiles
alert(alert: "Select one date folder. Direct contents only. Separate folder-date context is saved; no music or forScore changes.", title: "V3 service preview", cancel: true)
// V3-SERVICES-CONFIG ADD/RECONNECT: Replace ONLY next Nothing with native fixed File=v3-config.json. Reconnect next missing-value If and Get Text to this File output before deleting placeholder. Keep here outside branches/loops; If=does not have any value.
nothing() >> configFile
if(configFile == nil) {
runState = "error"
report = "Setup: set V3-SERVICES-CONFIG to v3-config.json."
}
if(runState == "ready") {
getTextFrom(input: configFile) >> configJson
getDictionaryFrom(input: configJson) >> config
valueFor(key: "version", dictionary: config) >> configVersion
text(text: "${configVersion}") >> versionText
if(versionText != "3") {
runState = "error"
report = "Config version 3 required."
}
valueFor(key: "servicePreview", dictionary: config) >> settings
valueFor(key: "maxFiles", dictionary: settings) >> maxFiles
matchText(text: "${maxFiles}", regex: "^[1-9][0-9]*$", caseSensitive: true) >> validLimit
if(validLimit == nil) {
runState = "error"
report = "Config servicePreview.maxFiles must be a positive integer."
}
}
if(runState == "ready") {
// V3-SERVICES-FOLDER ADD/RECONNECT: Replace ONLY next Nothing with native Select File: Folders, Multiple OFF. Reconnect next missing-value If, Name and later Folder Contents to picker output before deleting placeholder. Keep in this branch before context call; If=does not have any value.
nothing() >> selectedFolder
if(selectedFolder == nil) {
runState = "error"
report = "Setup: complete V3-SERVICES-FOLDER single-folder picker."
}
}
if(runState == "ready") {
fileDetail(input: selectedFolder, property: Name) >> folderName
list(items: ["${folderName}", "${configJson}"]) >> contextInput
runShortcut(name: "V3 - Load Folder Context", input: contextInput, show: false) >> contextResult
getDictionaryFrom(input: contextResult) >> dates
valueFor(key: "schemaVersion", dictionary: dates) >> dateSchema
text(text: "${dateSchema}") >> dateSchemaText
valueFor(key: "status", dictionary: dates) >> dateStatus
valueFor(key: "reason", dictionary: dates) >> dateReason
if(dateSchemaText != "1") {
runState = "error"
report = "Folder-context schema mismatch; inspect helper return."
}
if(dateStatus != "resolved") {
runState = "error"
report = "FOLDER: ${folderName} | STATUS: ${dateStatus} | REASON: ${dateReason}"
}
}
if(runState == "ready") {
valueFor(key: "startDate", dictionary: dates) >> startDate
valueFor(key: "endDate", dictionary: dates) >> endDate
valueFor(key: "qualifier", dictionary: dates) >> qualifier
valueFor(key: "yearSource", dictionary: dates) >> yearSource
text(text: """
V3 SERVICE PREVIEW
FOLDER: ${folderName}
QUALIFIER: ${qualifier}
DATES: ${startDate} to ${endDate}
YEAR SOURCE: ${yearSource}
Context saved separately; no music or forScore writes.
Direct folder contents only. Gaps allowed; duplicate positions unresolved.
""") >> heading
report = heading
// V3-SERVICES-FILES CHECK: Folder Contents input=selectedFolder picker output, Recursive OFF. Count/Repeat both use THIS original output. Only Name/Extension Text is stored; do not rebuild/pass native Files.
getFolderContents(folder: selectedFolder, recursive: false) >> folderFiles
count(type: Items, input: folderFiles) >> fileCount
calculate(input: "${maxFiles}") >> fileLimit
calculate(input: "100") >> hardLimit
if(fileCount > fileLimit) {
runState = "error"
report = "Folder has ${fileCount} items; configured preview limit is ${maxFiles}."
}
if(fileCount > hardLimit) {
runState = "error"
report = "This preview supports at most 100 direct items."
}
}
if(runState == "ready") {
repeatEach(folderFiles) {
calculate(input: "${fileIndex} + 1") >> nextFileIndex
fileIndex = nextFileIndex
fileDetail(input: RepeatItem, property: Name) >> sourceName
fileDetail(input: RepeatItem, property: File Extension) >> extension
setValue(key: "file-${fileIndex}-name", value: "${sourceName}", dictionary: files) >> filesWithName
setValue(key: "file-${fileIndex}-extension", value: "${extension}", dictionary: filesWithName) >> filesWithExtension
files = filesWithExtension
}
setValue(key: "_count", value: "${fileIndex}", dictionary: files) >> countedFiles
setValue(key: "_schemaVersion", value: "1", dictionary: countedFiles) >> finalFiles
// V3-SERVICES-TEXT CHECK: Get Text must serialize finalFiles and dates Dictionaries to valid JSON. Lists below contain actual Text tokens only. No File/Folder objects cross shortcut boundaries.
getTextFrom(input: finalFiles) >> filesJson
getTextFrom(input: dates) >> datesJson
list(items: ["${configJson}", "${datesJson}", "${filesJson}"]) >> rowsInput
runShortcut(name: "V3 - Prepare Preview Rows", input: rowsInput, show: false) >> rowsResult
getDictionaryFrom(input: rowsResult) >> rows
valueFor(key: "_schemaVersion", dictionary: rows) >> rowSchema
text(text: "${rowSchema}") >> rowSchemaText
valueFor(key: "_runState", dictionary: rows) >> rowState
valueFor(key: "_report", dictionary: rows) >> rowReport
if(rowSchemaText != "1") {
runState = "error"
report = "Preview-row schema mismatch; inspect helper return."
}
if(rowState != "ready") {
runState = "error"
report = "${report} | ROW ERROR: ${rowReport}"
}
}
if(runState == "ready") {
getTextFrom(input: rows) >> rowsJson
list(items: ["${rowsJson}", "${report}"]) >> renderInput
runShortcut(name: "V3 - Render Service Preview", input: renderInput, show: false) >> renderedReport
getTextFrom(input: renderedReport) >> reportText
report = reportText
if(reportText == nil) {
report = "Render Service Preview returned no Text; inspect its final action and caller target."
}
}
// V3-SERVICES-RETURN CHECK: Cleanup, Quick Look and final Get Text consume CURRENT named report, outside branches/loops. No Output/Exit/manual stop. Compiler workaround has no device pass yet.
replaceText(input: "${report}", find: "(?m)^ *\"{2} *$", replace: "", isRegex: true, caseSensitive: true) >> cleanedReport
report = cleanedReport
quicklook(input: report)
getTextFrom(input: report)
