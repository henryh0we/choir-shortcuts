// V3 - Preview Filenames | Purpose/role: Read-only V3 entry increment | Specification revision: 5; interface 3.0 | Contract: Direct launch; fixed config File set after import; pick music only; report Text by natural completion; input ignored; no music writes | Dependencies: V3 - Parse Filename interface 2.0 | Stage: Source reviewed only, not compiled or run; docs/v3-output-resolution.md
import Shortcuts

// SETTINGS / FORMATTING: Set the native File at V3-CONFIG-FILE once after import to the separate v3-config.json. Each run reads that File without a config picker; filenameFormats and weeklySchedule own the rules. Dates/overrides/sorting remain unimplemented. No manual stop blocks are needed; one native File reference requires setup.
var configJson = ""
var runState = "ready"
var report = """
V3 FILENAME PREVIEW
Filename and recurring schedule only. No dates, dated overrides, sorting, service plans or music writes in this increment.
Rows follow the provider selection order; this is not a running order.
"""
alert(alert: "Select PDFs to preview. The saved v3-config.json File supplies the rules. This reads names only; no archive or forScore changes.", title: "V3 filename preview", cancel: true)
// V3-CONFIG-FILE ADD/RECONNECT: Replace ONLY the next Nothing with native File (a fixed reference, NOT Select File). Tap its empty file field and choose v3-config.json once in the editor after import. Reconnect the following missing-value If and Get Text from Input to this File output, then delete only the placeholder. Keep here before config validation and outside every If/Repeat. Following If operator=does not have any value. No runtime config picker or stop/return insertion is required.
nothing() >> configFile
if(configFile == nil) {
runState = "error"
report = "V3 setup required: set the V3-CONFIG-FILE native File action to v3-config.json in the shortcut editor."
}
if(runState == "ready") {
getTextFrom(input: configFile) >> configJsonResult
configJson = configJsonResult
getDictionaryFrom(input: configJson) >> configSnapshot
valueFor(key: "version", dictionary: configSnapshot) >> configVersion
text(text: "${configVersion}") >> configVersionText
if(configVersionText != "3") {
runState = "error"
report = "ERROR: The saved config File must be the separate v3-config.json with version 3."
}
}
if(runState == "ready") {
selectFile(type: Files, multiple: true) >> selectedFilesResult
// V3-PREVIEW-SELECTION CHECK: Count input=THIS Select File selectedFilesResult output. Following If left=selectedFileCountText, operator=is, right=literal Text 0. No named File collection, Nothing initializer or has-value guard is used. The Repeat below consumes the same picker output within this scope.
count(type: Items, input: selectedFilesResult) >> selectedFileCount
text(text: "${selectedFileCount}") >> selectedFileCountText
if(selectedFileCountText == "0") {
runState = "error"
report = "V3 selection error: the music picker returned 0 items. No filename parsing attempted."
}
if(runState == "ready") {
text(text: """
${report}
Music picker item count: ${selectedFileCountText}
""") >> selectionReport
report = selectionReport
// V3-PREVIEW-FILES CHECK: Repeat input=selectedFilesResult native output from Select File above, not a Set Variable or Nothing. Name and File Extension consume this Repeat Item. File extensions classify names only; dependent processing is gated by runState.
repeatEach(selectedFilesResult) {
if(runState == "ready") {
fileDetail(input: RepeatItem, property: Name) >> sourceName
fileDetail(input: RepeatItem, property: File Extension) >> sourceExtension
matchText(text: "${sourceExtension}", regex: "^pdf$", caseSensitive: false) >> pdfExtension
if(pdfExtension == nil) {
text(text: """
${report}

FILE: ${sourceName}
STATUS: unresolved
REASON: Not a PDF filename; no service inferred.
""") >> unsupportedReport
report = unsupportedReport
}
if(pdfExtension != nil) {
// V3-PREVIEW-CALL CHECK: Two actual Text tokens in List, sourceName/configJson. Target=V3 - Parse Filename interface 2.0; result=one Dictionary with schemaVersion 2, including error status. Never target the caller itself. Natural completion and receiver type still need device verification.
list(items: ["${sourceName}", "${configJson}"]) >> parseInput
runShortcut(name: "V3 - Parse Filename", input: parseInput, show: false) >> rawResult
getDictionaryFrom(input: rawResult) >> parsedResult
valueFor(key: "schemaVersion", dictionary: parsedResult) >> resultVersion
text(text: "${resultVersion}") >> resultVersionText
if(resultVersionText != "2") {
runState = "error"
text(text: """
${report}

ERROR: V3 parser returned an unsupported result. Use V3 - Parse Filename interface 2.0 with this preview and inspect the final Dictionary and Run Shortcut connection.
Remaining selections were not processed.
""") >> invalidResultReport
report = invalidResultReport
}
if(runState == "ready") {
valueFor(key: "status", dictionary: parsedResult) >> parsedStatus
valueFor(key: "reason", dictionary: parsedResult) >> reason
matchText(text: "${parsedStatus}", regex: "^(parsed|skipped|unresolved|error)$", caseSensitive: true) >> validStatus
if(validStatus == nil) {
runState = "error"
text(text: """
${report}

ERROR: V3 parser returned no supported status. Remaining selections were not processed.
""") >> invalidStatusReport
report = invalidStatusReport
}
if(parsedStatus == "error") {
runState = "error"
text(text: """
${report}

FILE: ${sourceName}
STATUS: error
REASON: ${reason}
Remaining selections were not processed because configuration or parser input is invalid.
""") >> parserErrorReport
report = parserErrorReport
}
if(runState == "ready") {
valueFor(key: "dayKey", dictionary: parsedResult) >> dayKey
valueFor(key: "serviceSlot", dictionary: parsedResult) >> slotKey
valueFor(key: "serviceName", dictionary: parsedResult) >> serviceName
valueFor(key: "position", dictionary: parsedResult) >> position
valueFor(key: "canonicalName", dictionary: parsedResult) >> canonicalName
text(text: """
${report}

FILE: ${sourceName}
STATUS: ${parsedStatus}
DAY / SLOT: ${dayKey} / ${slotKey}
SERVICE: ${serviceName}
POSITION: ${position}
CANONICAL: ${canonicalName}
REASON: ${reason}
""") >> nextReport
report = nextReport
}
}
}
}
}
}
}
quicklook(input: report)
// V3-PREVIEW-COMPLETION CHECK: Last executable action=Get Text from current named report, after Quick Look and outside all branches/loops. Normal completion supplies the Text result. No generated output/exit binding or manual slot. Native picker cancellation/action failure can still abort before this point.
getTextFrom(input: report)
