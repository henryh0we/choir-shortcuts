// Installed name: MAIN - Build Choir Service
// Purpose: Start the interactive Nextcloud/iCloud/forScore service workflow.
// Role: Main; specification revision 3; interface 1.0.
// Input: None consumed. Direct launch only; ignores any incoming content.
// Output: One diagnostic service-report Text if the helper completes.
// Side effects: Selection UI, clean archive saves, imports/metadata/setlist writes.
// Native failures/cancellation can stop execution with partial writes and no report.
// Dependency: UTIL - Assemble Choir Service, interface 1.1, config/forScore slots completed.
// Source: ../reusable/util-assemble-choir-service.jelly
// Native insertion guide: ../../docs/choir-service-assembly.md
// Install order: Canonical Choir Name, completed Archive Choir PDF, completed Assemble Choir Service, main.
// Target: iPadOS 26.6; forScore 15.2.5; Jellycuts 2026.6.4 reported.
// Permissions: Files/Nextcloud/iCloud and forScore access requested on device.
// Profile: Existing source-reviewed runShortcut/output forms; bundled compiler unknown.
// Stage: Drafted, not compiled/imported/device tested.
// Contract/install: ../../docs/choir-service-build.md; tests: ../../tests/choir-service.md

import Shortcuts

text(text: "interactive") >> launchMode
runShortcut(name: "UTIL - Assemble Choir Service", input: launchMode, show: false) >> serviceReport
output(result: "${serviceReport}", noResultBehavior: Respond, response: "${serviceReport}")
